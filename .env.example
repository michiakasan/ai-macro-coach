# Copy this file to .env and fill in your key. .env is git-ignored.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Optional: override the chat model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: path to the SQLite file (default: ./macrotrack.db next to the code)
# MACROTRACK_DB=/absolute/path/to/macrotrack.db
